# ── API ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Fake Store ──────────────────────────────────────────────────────────
FAKESTORE_BASE_URL=https://fakestoreapi.com

# ── Cache ───────────────────────────────────────────────────────────────
PRODUCT_CACHE_TTL_SECONDS=300

# ── Products ────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
FEATURED_PRODUCT_IDS=1,3,5,6,12
CATEGORY_TOP_RATED_COUNT=3

# ── SMTP (Mailpit for local dev) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=catalogue@example.local
SALES_INBOX_EMAIL=sales@example.local
